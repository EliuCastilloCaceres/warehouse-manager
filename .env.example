# Copia este archivo como .env (no se versiona) y ajusta los valores.

# API
# Entorno: development | test | production
NODE_ENV=development
# Interfaz donde escucha la API (0.0.0.0 = todas)
HOST=0.0.0.0
# Puerto de la API
PORT=3000
# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Versión que reporta /api/v1/health
APP_VERSION=0.1.0

# Base de datos (docker-compose.dev.yml; la API la usará a partir de F1)
# Usuario de PostgreSQL
POSTGRES_USER=warehouse
# Contraseña de PostgreSQL
POSTGRES_PASSWORD=warehouse
# Nombre de la base de datos
POSTGRES_DB=warehouse_dev
# Cadena de conexión que usará Prisma
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse_dev
# Pruebas de integración (servicio postgres-test)
TEST_DATABASE_URL=postgresql://warehouse:warehouse@localhost:5433/warehouse_test
# Seed: contraseñas iniciales del Propietario (owner) y del admin (mín. 8 caracteres; se pide cambiarlas al entrar)
OWNER_INITIAL_PASSWORD=cambia-esta-clave-owner
ADMIN_INITIAL_PASSWORD=cambia-esta-clave

# Autenticación (genera el secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# Vida del access token (minutos, 1–60) y del refresh token (días, 1–30, ventana deslizante)
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# En desarrollo por HTTP sin certificados, pon false (si no, el navegador no guarda la cookie)
COOKIE_SECURE=true
# Imágenes subidas (relativo a apps/api)
UPLOADS_DIR=uploads
# true solo detrás de un proxy de confianza (Nginx en producción, F10)
TRUST_PROXY=false

# Web (Vite)
# A dónde reenvía Vite las llamadas a /api (si "localhost" choca con otro servicio, usa 127.0.0.1)
API_PROXY_TARGET=http://localhost:3000
# Certificados HTTPS de desarrollo (los genera "pnpm dev:certs")
DEV_HTTPS_KEY=infra/certs/dev-key.pem
DEV_HTTPS_CERT=infra/certs/dev-cert.pem
